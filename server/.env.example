# 文旅助手 · Linux 网关配置（复制为 .env 后填写）

# 监听端口
PORT=8080

# 上游 LLM（OpenAI 兼容，含 /v1；默认 DeepSeek）
# 已验证可用的上游示例：
#   DeepSeek: https://api.deepseek.com/v1
#   AgnesAI:  https://api.agnes-ai.cn/v1 （模型如 agnes-2.5-flash / agnes-2.5-pro）
LLM_BASE_URL=https://api.deepseek.com/v1

# 上游 LLM 的 API Key（服务器端持有，绝不下发前端）
LLM_API_KEY=sk-xxxxxxxx

# 默认模型名（仅当前端请求未指定模型时兜底；前端指定则透传）
LLM_MODEL=deepseek-chat

# 前端访问网关时需填的 Key（强烈建议设置；未设置则任何人可调用 LLM 代理）
# GATEWAY_KEY=wenlv-2026

# CORS 白名单（逗号分隔完整 origin，如 http://192.168.1.10:8090；未设置则放开所有来源）
# ALLOWED_ORIGINS=http://192.168.1.10:8090

# 上游 LLM 请求超时（毫秒，默认 120000）
# UPSTREAM_TIMEOUT_MS=120000

# ---- MCP 生态 ----

# MCP 代理白名单（逗号分隔 URL；未配置则 /mcp/proxy 禁用，仅本网关自身 /mcp 服务端可用）
# 前端「MCP」模块里填的 MCP server URL 必须在此白名单内才能通过网关转发连接
# MCP_PROXY_ALLOWLIST=http://localhost:9100,http://192.168.1.10:9100

# ---- 健康检查 ----
# GET /health（需 Gateway Key）返回运行状态；配合 uptime 监控使用
