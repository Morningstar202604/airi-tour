{
  "name": "@proj-airi/font-xiaolai",
  "type": "module",
  "version": "0.12.0-beta.5",
  "description": "Essential CSS for font, Xiaolai (小赖字体 / 小賴字體 / シャオライ / Xiaolai Font), used by Project AIRI",
  "author": "文旅助手项目组",
  "license": "SIL Open Font License",
  "homepage": "https://github.com/lxgw/kose-font",
  "exports": {
    ".": {
      "default": "./dist/index.css"
    },
    "./index.css": {
      "default": "./dist/index.css"
    },
    "./files/*": {
      "default": "./dist/files/*"
    },
    "./files/*.ttf": {
      "default": "./dist/files/*.ttf"
    },
    "./*": {
      "default": "./*.css"
    }
  },
  "main": "./dist/index.css",
  "scripts": {
    "dev": "pnpm run build",
    "build": "tsdown"
  }
}
