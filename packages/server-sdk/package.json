{
  "name": "@proj-airi/server-sdk",
  "type": "module",
  "version": "0.12.0-beta.5",
  "description": "Client-side SDK implementation for connecting to AIRI server components and runtimes",
  "author": "文旅助手项目组",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./utils/node": {
      "types": "./dist/utils/node/index.d.mts",
      "default": "./dist/utils/node/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "dev": "pnpm run build",
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@moeru/std": "catalog:",
    "@proj-airi/better-ws": "workspace:^",
    "@proj-airi/server-shared": "workspace:^",
    "superjson": "catalog:",
    "valibot": "catalog:"
  }
}
